# Copy to infra/.env and fill in. docker compose reads it.

# How the server is reached: "tunnel" (Cloudflare Tunnel, no open ports) or
# "caddy" (Caddy on ports 80 and 443, with its own certificate).
COMPOSE_PROFILES=tunnel
# For "tunnel": the tunnel's token. The "messenger" tunnel routes
# qchat.qwantarc.com; `cloudflared tunnel token messenger` prints its token.
TUNNEL_TOKEN=

# The server's hostname. Its DNS A (and AAAA) record must point at this VPS.
DOMAIN=qchat.qwantarc.com

# Who runs the server, sent to push services with each push.
MESSENGER_PUSH_CONTACT=mailto:you@example.com

# How long undelivered messages and uploaded files are kept, in days.
MESSENGER_RETENTION_DAYS=30
# Largest file people may send, and how much each account may upload a day, in MB.
# Cloudflare's free plan takes uploads up to 100 MB, padding included, so stay
# a little under it with the tunnel.
MESSENGER_MAX_FILE_MB=95
MESSENGER_DAILY_UPLOAD_MB=2048

# Where photos, videos, voice notes and files go. Left empty, they're kept in
# the server's volume. With a bucket (Cloudflare R2, or any S3-compatible
# service) phones upload and download straight to and from it: the files
# never pass through this VPS, so they don't count against its data
# allowance or disk. They're encrypted on the phone either way.
# For R2: Cloudflare → R2 → create a bucket, then "Manage API tokens" →
# create an "Object Read & Write" token for that bucket.
#MESSENGER_S3_ENDPOINT=https://<account id>.r2.cloudflarestorage.com
#MESSENGER_S3_BUCKET=messenger-files
#MESSENGER_S3_REGION=auto
#MESSENGER_S3_ACCESS_KEY=
#MESSENGER_S3_SECRET_KEY=

# Backups (infra/backup.sh, nightly). Encrypted with this age public key
# (`age-keygen -o messenger-backup.key` on your own computer, and keep the
# key file off the VPS), then uploaded to this bucket: use a different one
# from the files, so a mistake with one can't touch the other. Its token
# needs only "Object Write"; give the bucket a lifecycle rule that deletes
# backups after 30 days.
#BACKUP_AGE_RECIPIENT=age1...
#BACKUP_S3_BUCKET=messenger-backups
#BACKUP_S3_ACCESS_KEY=
#BACKUP_S3_SECRET_KEY=

# Pushes to iPhones and Macs (needs a paid Apple developer account). Put the
# key in infra/secrets/ and uncomment.
#MESSENGER_APNS_KEY=/secrets/AuthKey_KEYID.p8
#MESSENGER_APNS_KEY_ID=KEYID
#MESSENGER_APNS_TEAM_ID=TEAMID
#MESSENGER_APNS_TOPIC=com.qwantarc.messenger

# The image to run. CI publishes this one from main.
#SERVER_IMAGE=ghcr.io/ethchor/messenger-server:latest
